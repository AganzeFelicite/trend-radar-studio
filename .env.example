# Copy to .env and fill in the keys. Never commit .env (git ignores it).
# Every setting has a safe default in api/studio/config.py except the API keys.

# --- Character ---
CHARACTER_NAME=Big Dog

# --- Secrets: you create these accounts (docs/PLAN.md, decision D12) ---
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
FAL_KEY=
PEXELS_API_KEY=
POSTGRES_PASSWORD=studio

# --- Providers ---
LLM_MODEL=claude-opus-5-5
CLASSIFIER_MODEL=claude-opus-5-5
TTS_PROVIDER=elevenlabs
# Set in V2.3 once you pick the voice:
ELEVENLABS_VOICE_ID=
# V2.4 decides standard vs pro (fal-ai/kling-video/ai-avatar/v2/pro):
AVATAR_MODEL=fal-ai/kling-video/ai-avatar/v2/standard
# Set after decision D5:
IMAGE_MODEL=

# --- Monthly cost caps in USD (D8: $20 total). Jobs stop when a cap is reached. ---
CAP_LLM_USD=4
CAP_TTS_USD=6
CAP_AVATAR_USD=8
CAP_IMAGE_USD=2
CAP_VIDEO_USD=0

# --- Set by docker-compose; only needed for host-side alembic/pytest ---
# DATABASE_URL=postgresql+psycopg://studio:studio@localhost:5442/studio
# REDIS_URL=redis://localhost:6379/0
