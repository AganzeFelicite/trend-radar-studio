# Copy to .env and fill in the keys. Never commit .env (git ignores it).
# Every setting has a safe default in api/studio/config.py except the API keys.

# --- Character ---
CHARACTER_NAME=GameReporter

# --- Research and scripts: your headless Claude Code (no API key; your claude.ai login) ---
# Model: haiku, sonnet or opus
CLAUDE_MODEL=haiku

# --- Secrets ---
POSTGRES_PASSWORD=studio

# Kokoro TTS model folder (default: <repo>/models/kokoro):
# KOKORO_DIR=

# Research and scripts use your own Claude Code login (claude -p); no Anthropic API key needed.

# --- Monthly cost caps in USD. $0 = paid calls are refused until you raise a cap. ---
CAP_LLM_USD=0
CAP_TTS_USD=0
CAP_AVATAR_USD=0
CAP_IMAGE_USD=0
CAP_VIDEO_USD=0

# --- Set by docker-compose; only needed for host-side alembic/pytest ---
# DATABASE_URL=postgresql+psycopg://studio:studio@localhost:5442/studio
# REDIS_URL=redis://localhost:6379/0
